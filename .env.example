# =============================================================================
# TRETA SYSTEM & IRCTC COMPOUND DELAY ENGINE CONFIGURATION
# =============================================================================

# -----------------------------------------------------------------------------
# 1. LIVE RAILRADAR API CREDENTIALS
# -----------------------------------------------------------------------------
# Real-time GPS train tracking telemetry provider.
# If provided, the system queries live delays, instantaneous speeds, and progress.
# If left empty, the engine uses the internal simulation & zero-delay safety engine.
RAILRADAR_API_KEY=
RAILRADAR_API_URL=https://api.railradar.in/v1
LIVE_API_KEY=
API_KEY=

# -----------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (HYBRID SANDBOX ARCHITECTURE)
# -----------------------------------------------------------------------------
# Remote Neon Serverless PostgreSQL connection URL (optional).
# Example: postgresql://user:password@ep-project-id.ap-southeast-1.aws.neon.tech/WIN?sslmode=require
# If unconfigured or unreachable, the system automatically uses the local SQLite master database (WIN.db).
# The simulation database (WIN_SIMULATION.db) acts as the isolated working sandbox.
POSTGRESQL=
DATABASE_URL=
NEON_URL=

# -----------------------------------------------------------------------------
# 3. LOCAL SERVER CONFIGURATION
# -----------------------------------------------------------------------------
PORT=8000
HOST=0.0.0.0

# -----------------------------------------------------------------------------
# 4. FRONTEND TO BACKEND PROXY ROUTING
# -----------------------------------------------------------------------------
# For local development: http://127.0.0.1:8000
# For Vercel production: URL of deployed backend service
BACKEND_URL=http://127.0.0.1:8000
NEXT_PUBLIC_BACKEND_URL=http://127.0.0.1:8000
